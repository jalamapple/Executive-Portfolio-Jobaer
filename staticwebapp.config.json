{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/js/*",
      "/images/*",
      "/downloads/*",
      "/*.{ico,png,jpg,jpeg,webp,svg,css,js,zip,json,txt}"
    ]
  },
  "mimeTypes": {
    ".css": "text/css",
    ".js": "application/javascript",
    ".zip": "application/zip",
    ".webp": "image/webp",
    ".svg": "image/svg+xml"
  }
}
